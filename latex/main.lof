\contentsline {figure}{\numberline {1.1}{\ignorespaces Rappresentazione schematica di una cella di lavoro collaborativa. Viene evidenziata la sovrapposizione tra il volume operativo dell'operatore (\textit {Human work envelope}) e l'area di lavoro del robot (\textit {Robot work envelope}).\relax }}{2}{figure.caption.4}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces Rappresentazione schematica del principio di Speed and Separation Monitoring (SSM).\relax }}{4}{figure.caption.5}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Rappresentazione geometrica di una Sphere Swept Line (SSL).\relax }}{8}{figure.caption.6}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Confronto tra la geometria dettagliata del robot (a) e la sua rappresentazione semplificata a capsule (b).\relax }}{9}{figure.caption.7}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Rappresentazione geometrica della distanza minima $d_{seg}$ tra due segmenti $S_1$ e $S_2$.\relax }}{11}{figure.caption.8}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Profili temporali di posizione $q(t)$, velocità $\dot {q}(t)$ e accelerazione $\ddot {q}(t)$ durante la manovra di arresto morbido con polinomio quintico.\relax }}{13}{figure.caption.9}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces Robot collaborativo \textit {Franka Emika Panda}\relax }}{19}{figure.caption.12}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Confronto tra le coppie reali misurate ai giunti e le coppie stimate tramite il modello dinamico in Pinocchio.\relax }}{25}{figure.caption.17}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Architettura software del sistema di controllo. L'alto livello gestisce la pianificazione offline e la ri-pianificazione delle traiettorie, mentre il basso livello esegue il loop di controllo ad alta frequenza ($1\text { kHz}$) alternando deterministicamente gli stati di \texttt {RUNNING} e \texttt {STOPPING}.\relax }}{33}{figure.caption.21}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Profilo delle velocità ai giunti registrato con l'adozione del controllo di posizione. Si notino i picchi impulsivi e il fenomeno di \textit {jitter} dovuto alle discontinuità dei riferimenti.\relax }}{42}{figure.caption.24}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Profilo delle velocità ai giunti con schema di controllo di coppia guidato dal regolatore PD. L'azione del controllore elimina i picchi, garantendo un'andamento fluido e privo di \textit {ripple}.\relax }}{42}{figure.caption.25}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Profilo temporale delle velocità ai giunti durante la traiettoria di \textit {pick-and-place}. Al tempo $t \approx 2.5\text { s}$ viene rilevato l'ostacolo e attivata la procedura di arresto continuo.\relax }}{44}{figure.caption.26}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Andamento del tempo di arresto ottimizzato $T_{\text {stop}}$. Si nota la modulazione continua tra il valore minimo ($0.25\text { s}$) e massimo ($0.4\text { s}$) in base alla velocità istantanea.\relax }}{44}{figure.caption.27}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Evoluzione temporale dei raggi delle capsule di protezione dinamiche, coerente con il profilo di decelerazione del robot.\relax }}{45}{figure.caption.28}%
